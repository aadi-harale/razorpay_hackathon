# Local full mode
DATABASE_URL="file:./.data/razorprocure.db"
APP_ORIGIN="http://localhost:3100"
# Local launcher overwrites the next two values with the single local demo account.
# For Vercel/production, set your own email and strong password in deployment env vars.
DEMO_EMAIL="merchant@razorprocure.local"
DEMO_PASSWORD="replace-with-strong-local-password"
SESSION_SECRET="replace-with-64-char-random-secret"
AGENT_API_TOKEN="replace-with-random-agent-token"

# Public-safe default: dummy payments, no external account or network call.
PAYMENT_MODE="demo"

# Optional private/local Razorpay Test Mode. Set PAYMENT_MODE="razorpay_test"
# intentionally before using these. Live-mode keys are always rejected.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Language layer only. Never authorizes money, policy, inventory, or payment.
LLM_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

DEMO_GATEWAY_GST_RECOVERABLE="true"
